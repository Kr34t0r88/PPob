<%- include('../partials/header') %>

<div class="max-w-2xl mx-auto space-y-5">
  
  <div class="flex items-center gap-3">
    <a href="/admin/agents" class="btn btn-sm btn-ghost text-xs gap-1.5 text-slate-500">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      <span>Kembali</span>
    </a>
    <h3 class="text-lg lg:text-xl font-bold text-slate-900 dark:text-white tracking-tight"><%= isEdit ? 'Edit Agen' : 'Tambah Agen Baru' %></h3>
  </div>

  <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 p-6 shadow-sm">
    
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="p-3 mb-4 rounded-xl bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-900 text-xs text-red-600 dark:text-red-400 flex items-center gap-2">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="<%= action %>" method="POST" class="space-y-4">
      
      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Nama Lengkap / Toko *</label>
        <input type="text" name="name" value="<%= agent ? agent.name : '' %>" required class="input-fintech w-full" placeholder="Contoh: Konter Budi Cell" />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Username *</label>
          <input type="text" name="username" value="<%= agent ? agent.username : '' %>" <%= isEdit ? 'readonly class="input-fintech w-full bg-slate-100 dark:bg-slate-800 cursor-not-allowed"' : 'required class="input-fintech w-full"' %> placeholder="budicell" />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Nomor WhatsApp *</label>
          <input type="text" name="phone" value="<%= agent ? agent.phone : '' %>" required class="input-fintech w-full font-mono" placeholder="081234567890" />
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Email (Opsional)</label>
        <input type="email" name="email" value="<%= agent ? agent.email : '' %>" class="input-fintech w-full" placeholder="budi@example.com" />
      </div>

      <% if (!isEdit) { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Password *</label>
            <input type="password" name="password" required class="input-fintech w-full" placeholder="Minimal 6 karakter" />
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5">Saldo Awal (Rp)</label>
            <input type="number" name="initial_balance" value="0" class="input-fintech w-full font-mono" placeholder="0" />
          </div>
        </div>

        <div class="p-3.5 bg-blue-50/60 dark:bg-blue-950/30 rounded-xl border border-blue-200/70 dark:border-blue-900/50 flex items-start gap-2.5 text-xs text-blue-800 dark:text-blue-300">
          <svg class="w-4 h-4 shrink-0 text-blue-600 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <div>
            <span class="font-bold">Otomatisasi Onboarding Agen:</span>
            <p class="text-[11px] text-blue-700/80 dark:text-blue-300/80 mt-0.5">
              Setelah disimpan, sistem akan secara otomatis membuat <strong>QR Code 1-Scan Login APK</strong> dan mengirimkannya ke WhatsApp agen. Agen cukup membuka APK dan menekan tombol <em>Scan QR Code Akun</em>.
            </p>
          </div>
        </div>
      <% } %>

      <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex justify-end gap-2.5">
        <a href="/admin/agents" class="btn btn-sm btn-ghost text-xs">Batal</a>
        <button type="submit" class="btn btn-sm bg-blue-600 hover:bg-blue-700 text-white border-0 text-xs font-semibold">Simpan & Buat QR Agen</button>
      </div>

    </form>

  </div>

</div>

<%- include('../partials/footer') %>
