<%- include('../partials/header') %>

<div class="space-y-5">

  <!-- Header Action Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
      <h3 class="text-lg lg:text-xl font-bold text-slate-900 dark:text-white tracking-tight">Katalog Produk & Margin</h3>
      <p class="text-xs text-slate-500">Kelola price-list Digiflazz, margin keuntungan server, dan aktivasi SKU.</p>
    </div>
    <div class="flex items-center gap-2">
      <!-- Bulk Margin Button -->
      <button type="button" onclick="document.getElementById('modal-bulk-margin').showModal()" class="btn btn-sm bg-emerald-600 hover:bg-emerald-700 text-white border-0 text-xs font-semibold gap-1.5 shadow-sm">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <span>Ubah Margin Massal</span>
      </button>

      <form action="/admin/products/sync" method="POST" onsubmit="this.querySelector('button').disabled=true; this.querySelector('button').innerHTML='Menyinkronkan...';">
        <button type="submit" class="btn btn-sm bg-blue-600 hover:bg-blue-700 text-white border-0 text-xs font-semibold gap-1.5 shadow-sm">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
          <span>Sinkronisasi Digiflazz</span>
        </button>
      </form>
    </div>
  </div>

  <!-- Modal Ubah Margin Massal -->
  <dialog id="modal-bulk-margin" class="modal">
    <div class="modal-box bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 max-w-md">
      <h3 class="font-bold text-base text-slate-900 dark:text-white mb-2">Ubah Margin Massal</h3>
      <p class="text-xs text-slate-500 mb-4">Setel margin keuntungan untuk Agen atau Publik. Harga jual akan dihitung otomatis (<code class="font-mono text-blue-500">Harga Modal + Margin</code>).</p>
      
      <form action="/admin/products/bulk-markup" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Target Harga Margin</label>
          <select name="target_type" class="input-fintech w-full font-semibold">
            <option value="agent">👤 Margin Agen Reseller (Aplikasi APK)</option>
            <option value="public" selected>🌐 Margin Publik (Web Storefront)</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Nominal Margin (+Rp)</label>
          <input type="number" name="markup" required placeholder="Contoh: 3000" min="0" step="50" class="input-fintech w-full font-mono" />
          <p class="text-[11px] text-slate-400 mt-1">Keuntungan yang ditambahkan di atas harga modal Digiflazz.</p>
        </div>

        <div>
          <label class="block text-xs font-medium text-slate-700 dark:text-slate-300 mb-1">Kategori Produk</label>
          <select name="category" class="input-fintech w-full">
            <option value="">Semua Kategori (Global Seluruh Produk)</option>
            <% categories.forEach(c => { %>
              <option value="<%= c.category %>"><%= c.category %> (<%= c.product_count %> produk)</option>
            <% }) %>
          </select>
          <p class="text-[11px] text-slate-400 mt-1">Pilih kategori tertentu atau terapkan ke semua produk.</p>
        </div>

        <div class="modal-action flex justify-end gap-2 pt-2">
          <button type="button" onclick="document.getElementById('modal-bulk-margin').close()" class="btn btn-sm btn-ghost text-xs">Batal</button>
          <button type="submit" class="btn btn-sm bg-emerald-600 hover:bg-emerald-700 text-white border-0 text-xs font-semibold">Terapkan Margin</button>
        </div>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>

  <!-- Search & Filter Bar -->
  <div class="bg-white dark:bg-slate-900 p-4 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm">
    <form action="/admin/products" method="GET" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5">
      <div>
        <input type="text" name="q" value="<%= filter.q || '' %>" placeholder="Cari SKU, nama produk, brand..." class="input-fintech w-full" />
      </div>

      <div>
        <select name="category" class="input-fintech w-full">
          <option value="">Semua Kategori</option>
          <% categories.forEach(c => { %>
            <option value="<%= c.category %>" <%= filter.category === c.category ? 'selected' : '' %>><%= c.category %> (<%= c.product_count %>)</option>
          <% }) %>
        </select>
      </div>

      <div>
        <select name="status" class="input-fintech w-full">
          <option value="active" <%= filter.status === 'active' || !filter.status ? 'selected' : '' %>>Produk Aktif Saja</option>
          <option value="inactive" <%= filter.status === 'inactive' ? 'selected' : '' %>>Produk Nonaktif Saja</option>
          <option value="all" <%= filter.status === 'all' ? 'selected' : '' %>>Semua Status</option>
        </select>
      </div>

      <div class="flex gap-2">
        <button type="submit" class="btn btn-sm bg-slate-900 hover:bg-slate-800 text-white border-0 flex-1 text-xs">Filter</button>
        <a href="/admin/products" class="btn btn-sm btn-ghost text-xs">Reset</a>
      </div>
    </form>
  </div>

  <!-- Products Table (Horizontal Touch-Scroll) -->
  <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="fintech-table">
        <thead>
          <tr>
            <th>SKU</th>
            <th>Nama Produk</th>
            <th>Kategori</th>
            <th>Brand</th>
            <th>Modal H2H</th>
            <th>Harga Agen (+Rp)</th>
            <th>Harga Publik (+Rp)</th>
            <th>Status</th>
            <th class="text-right">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (products && products.length > 0) { %>
            <% products.forEach(p => { %>
              <tr>
                <td>
                  <button type="button" onclick="copyToClipboard('<%= p.sku %>', 'SKU')" class="btn-copy" title="Salin SKU">
                    <span><%= p.sku %></span>
                    <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2"></path></svg>
                  </button>
                </td>
                <td>
                  <div class="text-xs font-semibold text-slate-800 dark:text-slate-200 max-w-[200px] truncate" title="<%= p.product_name %>">
                    <%= p.product_name %>
                  </div>
                  <% if (p.description) { %>
                    <p class="text-[10px] text-slate-400 truncate max-w-[200px]"><%= p.description %></p>
                  <% } %>
                </td>
                <td>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                    <%= p.category %>
                  </span>
                </td>
                <td class="text-xs text-slate-500"><%= p.brand || '-' %></td>
                <td class="font-mono text-xs text-slate-600 dark:text-slate-300"><%= formatRupiah(p.price_modal) %></td>
                
                <!-- Agen Markup & Price -->
                <td>
                  <div class="font-mono text-xs font-bold text-blue-600 dark:text-blue-400">
                    <%= formatRupiah(p.price_sell) %>
                  </div>
                  <div class="text-[10px] text-slate-400 font-mono">Margin: +<%= formatRupiah(p.markup || 0) %></div>
                </td>

                <!-- Public Markup & Price -->
                <td>
                  <form action="/admin/products/<%= p.sku %>/public-markup" method="POST" class="flex items-center gap-1">
                    <input type="number" name="markup_public" value="<%= p.markup_public || 3000 %>" class="input-fintech w-16 text-right py-0.5 px-1.5 text-xs font-mono" title="Margin Publik (+Rp)" />
                    <button type="submit" class="p-1 rounded text-emerald-600 hover:bg-emerald-50 dark:hover:bg-emerald-900/20" title="Simpan Margin Publik">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    </button>
                  </form>
                  <div class="font-mono text-[11px] font-bold text-emerald-600 dark:text-emerald-400">
                    Jual: <%= formatRupiah(p.price_public || (p.price_modal + (p.markup_public || 3000))) %>
                  </div>
                </td>
                
                <td>
                  <% if (p.is_active) { %>
                    <span class="badge-status badge-status-success">
                      <span class="dot-pulse dot-pulse-success"></span> Aktif
                    </span>
                  <% } else { %>
                    <span class="badge-status badge-status-failed">
                      <span class="dot-pulse dot-pulse-failed"></span> Nonaktif
                    </span>
                  <% } %>
                </td>

                <td class="text-right">
                  <form action="/admin/products/<%= p.sku %>/toggle" method="POST" class="inline">
                    <input type="hidden" name="is_active" value="<%= p.is_active ? '0' : '1' %>" />
                    <button type="submit" class="btn btn-xs <%= p.is_active ? 'btn-ghost text-red-500 hover:bg-red-50' : 'btn-ghost text-emerald-600 hover:bg-emerald-50' %> font-semibold text-[11px]">
                      <%= p.is_active ? 'Matikan' : 'Aktifkan' %>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="9" class="text-center py-10 text-xs text-slate-400">
                Belum ada produk. Silakan klik tombol "Sinkronisasi Digiflazz".
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (pagination && pagination.totalPages > 1) { %>
      <div class="p-3.5 border-t border-slate-100 dark:border-slate-800 flex justify-center">
        <div class="join">
          <% for(let i = 1; i <= pagination.totalPages; i++) { %>
            <a href="/admin/products?page=<%= i %>&q=<%= filter.q || '' %>&category=<%= filter.category || '' %>&status=<%= filter.status || '' %>"
               class="join-item btn btn-xs <%= pagination.page === i ? 'btn-active bg-blue-600 text-white border-0' : 'btn-ghost' %>">
              <%= i %>
            </a>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>

</div>

<%- include('../partials/footer') %>
