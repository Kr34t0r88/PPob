<%- include('../partials/header') %>

<div class="space-y-5">

  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <a href="/admin/agents/<%= agent ? agent.id : '' %>" class="btn btn-sm btn-ghost text-xs gap-1.5 text-slate-500">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        <span>Kembali ke Detail Agen</span>
      </a>
      <h3 class="text-lg lg:text-xl font-bold text-slate-900 dark:text-white tracking-tight">Riwayat Mutasi Saldo: <%= agent ? agent.name : '' %></h3>
    </div>
  </div>

  <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="fintech-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Waktu</th>
            <th>Tipe Mutasi</th>
            <th>Nominal</th>
            <th>Saldo Awal</th>
            <th>Saldo Akhir</th>
            <th>Ref ID / Catatan</th>
            <th>Oleh</th>
          </tr>
        </thead>
        <tbody>
          <% if (mutations && mutations.length > 0) { %>
            <% mutations.forEach(m => { %>
              <tr>
                <td class="font-mono text-xs text-slate-400">#<%= m.id %></td>
                <td class="text-xs font-mono text-slate-400 whitespace-nowrap"><%= formatDateTime(m.created_at) %></td>
                <td>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold <%= m.type === 'deposit' || m.type === 'refund' ? 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-400' : 'bg-red-50 text-red-700 dark:bg-red-950/50 dark:text-red-400' %> uppercase">
                    <%= m.type %>
                  </span>
                </td>
                <td class="font-mono text-xs font-bold <%= m.type === 'deposit' || m.type === 'refund' ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-600 dark:text-red-400' %>">
                  <%= m.type === 'deposit' || m.type === 'refund' ? '+' : '-' %><%= formatRupiah(m.amount) %>
                </td>
                <td class="font-mono text-xs text-slate-600 dark:text-slate-300"><%= formatRupiah(m.balance_before) %></td>
                <td class="font-mono text-xs font-bold text-slate-900 dark:text-white"><%= formatRupiah(m.balance_after) %></td>
                <td class="text-xs">
                  <% if (m.ref_id) { %>
                    <span class="font-mono text-blue-600 dark:text-blue-400 font-semibold">[<%= m.ref_id %>]</span>
                  <% } %>
                  <span class="text-slate-600 dark:text-slate-300"><%= m.notes || '-' %></span>
                </td>
                <td class="text-xs text-slate-400 font-medium"><%= m.created_by || 'Sistem' %></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center py-10 text-xs text-slate-400">Tidak ada riwayat mutasi saldo.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
      <div class="p-3.5 border-t border-slate-100 dark:border-slate-800 flex justify-center">
        <div class="join">
          <% for(let i = 1; i <= totalPages; i++) { %>
            <a href="/admin/agents/<%= agent ? agent.id : '' %>/mutations?page=<%= i %>"
               class="join-item btn btn-xs <%= page === i ? 'btn-active bg-blue-600 text-white border-0' : 'btn-ghost' %>">
              <%= i %>
            </a>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>

</div>

<%- include('../partials/footer') %>
